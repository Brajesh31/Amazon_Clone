# EditorConfig keeps whitespace and line endings consistent across contributors.
# These rules do not replace language-specific formatting or validation.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Preserve Markdown hard line breaks and intentional trailing spaces.
trim_trailing_whitespace = false

[*.html]
indent_size = 4

[*.css]
indent_size = 4

[*.js]
indent_size = 4

[*.py]
indent_size = 4
